# systemd user unit that keeps merud running. Install steps are in
# deploy/README.md. %h is systemd's name for your home directory.

[Unit]
Description=Meru daemon (merud)
Documentation=https://github.com/aarora79/meru

[Service]
Type=simple
# The release installer puts the daemon in ~/.local/bin.
ExecStart=%h/.local/bin/merud
# Restart after a crash, but not after `systemctl --user stop merud`.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
